{
  "name": "Backup Diario Supabase → Google Drive",
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "backup" }, { "name": "supabase" }],
  "nodes": [
    {
      "id": "trig-daily",
      "name": "Diario 2 AM (México)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 400],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        },
        "timezone": "America/Mexico_City"
      }
    },
    {
      "id": "export-users",
      "name": "Export users",
