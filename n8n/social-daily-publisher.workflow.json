    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE social_posts sp\nSET status = CASE\n  WHEN EXISTS (\n    SELECT 1\n    FROM social_post_targets spt\n    WHERE spt.post_id = sp.id\n      AND spt.status = \u0027failed\u0027\n  ) THEN \u0027failed\u0027\n  WHEN NOT EXISTS (\n    SELECT 1\n    FROM social_post_targets spt\n    WHERE spt.post_id = sp.id\n      AND spt.status IN (\u0027draft\u0027, \u0027scheduled\u0027)\n  ) THEN \u0027published\u0027\n  ELSE sp.status\nEND,\nupdated_at = NOW()\nWHERE sp.id = \u0027{{ $item(0).$node[\"Merge Targets\"].json.post_id }}\u0027::uuid;"
      },
